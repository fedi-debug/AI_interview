# HireNest local configuration
DATABASE_URL=sqlite:///d:/interview/hirenest/data/hirenest.db

# --- Speech-to-text (pick one) ---
MOCK_ASR=false
MOCK_LLM=true
ASR_ENGINE=auto
TTS_ENGINE=piper
FASTER_WHISPER_MODEL=base.en
FASTER_WHISPER_DEVICE=cuda
FASTER_WHISPER_COMPUTE=float16
PIPER_MODEL=d:/interview/hirenest/models/piper/en_US-lessac-medium.onnx
PIPER_CONFIG=d:/interview/hirenest/models/piper/en_US-lessac-medium.onnx.json
WHISPER_THREADS=4

# --- Natural voice TTS (Piper) — female: amy, kathleen, ljspeech, cori ---
TTS_ENGINE=piper
PIPER_VOICE=amy
PIPER_MODEL=d:/interview/hirenest/models/piper/en_US-amy-medium.onnx
PIPER_CONFIG=d:/interview/hirenest/models/piper/en_US-amy-medium.onnx.json
PIPER_BIN=d:/interview/hirenest/bin/piper/piper.exe

# --- LLM interviewer ---
MOCK_LLM=true
LLAMA_BIN=d:/interview/hirenest/bin/llama/llama-cli.exe
LLAMA_MODEL=d:/interview/hirenest/models/llama/phi-2.Q4_K_M.gguf
LLAMA_NGL=0
LLAMA_THREADS=6
LLAMA_MAX_TOKENS=512

OPENSMILE_BIN=
USE_PROSODY_FALLBACK=true
AUDIO_CHUNK_SEC=1.5
VIDEO_FPS=6

SCORE_WEIGHTS_CONTENT=0.50
SCORE_WEIGHTS_FLUENCY=0.20
SCORE_WEIGHTS_PROSODY=0.15
SCORE_WEIGHTS_NONVERBAL=0.15
